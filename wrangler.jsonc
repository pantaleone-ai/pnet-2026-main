{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pantaleonenet",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"limits": {
		"cpu_ms": 30000
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pantaleonenet"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "CHAT_DB",
			"database_name": "pantaleone-chat-prod",
			"database_id": "62f4e755-4aa9-4a51-8364-d93c9ae90470",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "pnet-chat-index"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CHAT_ANALYTICS",
			"id": "b811d0f5bc4a40b1a5c86ac8ff33af64"
		},
		{
			"binding": "CHAT_PLATFORM",
			"id": "59c956ebc41f45838fab8ff33af64"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "CHAT_INGEST",
				"queue": "chat-ingest"
			}
		]
	},
	"env": {
		"staging": {
			"name": "pantaleonenet-staging",
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "pantaleonenet-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"d1_databases": [
				{
					"binding": "CHAT_DB",
					"database_name": "pantaleone-chat-staging",
					"database_id": "46df8b0b-3cf0-42e4-a914-022fe6fcd05f",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"kv_namespaces": [
				{
					"binding": "CHAT_ANALYTICS",
					"id": "b811d0f5bc4a40b1a5c86ac8ff33af64"
				},
				{
					"binding": "CHAT_PLATFORM",
					"id": "2448c9fa5c3448abfe4ec6bdb53a8"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "CHAT_INGEST",
						"queue": "chat-ingest-staging"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "pantaleonenet-opennext-cache-staging"
				},
				{
					"binding": "CHAT_UPLOADS",
					"bucket_name": "pantaleone-chat-uploads-staging"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "pnet-chat-index"
				}
			],
			"observability": {
				"enabled": true
			}
		},
		"development": {
			"name": "pantaleonenet-dev",
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "pantaleonenet-dev"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"d1_databases": [
				{
					"binding": "CHAT_DB",
					"database_name": "pantaleone-chat-dev",
					"database_id": "648e9d0b-364c-4a51-8364-d93c9ae90470",
					"migrations_dir": "drizzle/migrations"
				}
			],
			"kv_namespaces": [
				{
					"binding": "CHAT_ANALYTICS",
					"id": "b811d0f5bc4a40b1a5c86ac8ff33af64"
				},
				{
					"binding": "CHAT_PLATFORM",
					"id": "cc15922efc81452a8abfe4ec6bdb53a8"
				}
			],
			"queues": {
				"producers": [
					{
						"binding": "CHAT_INGEST",
						"queue": "chat-ingest-dev"
					}
				]
			},
			"r2_buckets": [
				{
					"binding": "NEXT_INC_CACHE_R2_BUCKET",
					"bucket_name": "pantaleonenet-opennext-cache-dev"
				},
				{
					"binding": "CHAT_UPLOADS",
					"bucket_name": "pantaleone-chat-uploads-dev"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORIZE",
					"index_name": "pnet-chat-index"
				}
			],
			"observability": {
				"enabled": true
			}
		}
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "pantaleonenet-opennext-cache"
		},
		{
			"binding": "CHAT_UPLOADS",
			"bucket_name": "pantaleone-chat-uploads"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}