{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "pantaleonenet",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"limits": {
		"cpu_ms": 30000
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "pantaleonenet"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			// TEMPORARY until the env split lands: all envs share the DEV
			// database. No production code path touches CHAT_DB yet (no SaaS
			// UI, no hostname), so this is safe — but do NOT ship SaaS UI or
			// chat.pantaleone.net traffic before splitting per-env bindings.
			"binding": "CHAT_DB",
			"database_name": "pantaleone-chat-dev",
			"database_id": "648e9d0b-364c-4a51-8364-d93c9ae90470",
			"migrations_dir": "drizzle/migrations"
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "pnet-chat-index"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CHAT_ANALYTICS",
			"id": "b811d0f5bc4a40b1a5c86ac8ff33af64"
		},
		{
			// TEMPORARY: dev namespace for all envs (see CHAT_DB note above).
			"binding": "CHAT_PLATFORM",
			"id": "cc15922efc81452a8abfe4ec6bdb53a8"
		}
	],
	"queues": {
		"producers": [
			{
				// TEMPORARY: dev queue for all envs (see CHAT_DB note above).
				"binding": "CHAT_INGEST",
				"queue": "chat-ingest-dev"
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "pantaleonenet-opennext-cache"
		},
		{
			// TEMPORARY: dev bucket for all envs (see CHAT_DB note above).
			"binding": "CHAT_UPLOADS",
			"bucket_name": "pantaleone-chat-uploads-dev"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}