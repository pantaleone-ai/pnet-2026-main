# Environment Variables Template

# Copy this file to `.env.local` and fill in the values
# DO NOT commit `.env.local` to version control

# ============================================
# Required Variables
# ============================================

# Resend API Key (Required for contact form)
# Get your API key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key

# Contact Email — admin inbox for contact + newsletter notifications.
# Single address or comma-separated list, e.g. "you@gmail.com, contact@yourdomain.com".
# IMPORTANT: the address must be deliverable (its domain needs MX records).
# Resend accepts mail for undeliverable addresses and it bounces later, so the
# form will look successful while you receive nothing. Defaults to contact@pantaleone.net.
CONTACT_EMAIL=your@email.com

# Sender addresses must use a domain verified in Resend.
# Verify at https://resend.com/domains, then set e.g. contact@pantaleone.net.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@verified-domain.com>
NEWSLETTER_FROM_EMAIL=Build Notes <contact@verified-domain.com>

# Resend audience for newsletter / lead-magnet signups (optional)
# Find it at https://resend.com/audiences
RESEND_AUDIENCE_ID=your_resend_audience_id

# ============================================
# Analytics & Monitoring
# ============================================

# Google Analytics (Optional)
# Get your Measurement ID from: https://analytics.google.com/
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Meta Pixel (Optional — dataset pantaleone.net-2026)
# Get your Pixel ID from: https://www.facebook.com/business/help/952192354722245
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXX

# Meta Conversions API token (server-only — NEVER commit, NEVER NEXT_PUBLIC_).
# Mint from the Conversions API System User in Events Manager.
# META_CAPI_ACCESS_TOKEN=EAA...
# Optional Test Events code for dedup verification (never in production):
# META_TEST_EVENT_CODE=TEST12345
# Optional build fingerprint used by the prod-host gate (set to production
# on the Vercel production environment; preview/dev fail closed):
# NEXT_PUBLIC_VERCEL_ENV=production

# PostHog Analytics (Optional)
# Get your API key from: https://posthog.com/
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://app.posthog.com

# ============================================
# Portfolio Growth OS (per-app, on-demand only)
# Absent = disabled. Server tokens never NEXT_PUBLIC_.
# <APP> = registry id uppercased, non-alphanumerics to _,
# e.g. synthetic-pics -> SYNTHETIC_PICS, print3dmodels -> PRINT3DMODELS
# ============================================

# Per-app GA4 measurement IDs (fallback: NEXT_PUBLIC_GOOGLE_ANALYTICS_ID)
# NEXT_PUBLIC_GA4_ID_SYNTHETIC_PICS=G-XXXXXXXXXX
# NEXT_PUBLIC_GA4_ID_MIXPHD=G-XXXXXXXXXX

# Per-app Meta datasets (fallback: NEXT_PUBLIC_META_PIXEL_ID).
# Verified 2026-10-09 via Graph API (dataset name: synthetic.pics-dataset).
NEXT_PUBLIC_META_PIXEL_ID_SYNTHETIC_PICS=1572374234065992
# Optional server-only dataset override (takes precedence when set):
# META_DATASET_ID_SYNTHETIC_PICS=1572374234065992
# Per-app CAPI tokens, server-only (fallback: META_CAPI_ACCESS_TOKEN)
# META_CAPI_ACCESS_TOKEN_SYNTHETIC_PICS=EAA...

# Scaffolded channels — unset until paid test (see lib/growth/platforms/)
# PINTEREST_TAG_ID_<APP>=xxx
# X_PIXEL_ID_<APP>=xxx
# REDDIT_PIXEL_ID_<APP>=xxx

# Vercel Analytics (automatically provided by Vercel)
# No configuration needed if deployed on Vercel

# ============================================
# Application Settings
# ============================================

# Base URL for the application
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# Optional: Third-party Services
# ============================================

# IndexNow API Key (Required for instant search engine indexing)
# Generate your API key at: https://www.bing.com/indexnow/getstarted
# This enables instant indexing with Bing, Yandex, and other IndexNow participants
INDEXNOW_API_KEY=your_indexnow_api_key

# Add any additional API keys or secrets here
# Example:
# GITHUB_TOKEN=your_github_token
# TWITTER_API_KEY=your_twitter_api_key

# ============================================
# Campaign OS (optional — all endpoints work
# without keys in deterministic-local mode)
# ============================================

# Machine auth for tick/execute/metrics/events endpoints.
# Set in production; required by .github/workflows/campaign-tick.yml.
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# Local snapshot durability (gitignored). Ephemeral on serverless.
CAMPAIGN_SNAPSHOT_PATH=data/campaign-os.snapshot.json

# Channels (adapters report disconnected until set — never faked)
# WEBSITE_API_BASE=https://your-cms.example.com
# WEBSITE_API_TOKEN=xxx
# LINKEDIN_ACCESS_TOKEN=xxx
# LINKEDIN_PERSON_URN=urn:li:person:xxx
# EMAIL_PROVIDER_API_KEY=xxx
# EMAIL_FROM=Campaign <contact@pantaleone.net>
# EMAIL_TEST_RECIPIENT=you@example.com

# AI generation (optional — falls back to deterministic-local synthesis)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# EVAL_MODEL=openai/gpt-4o-mini
